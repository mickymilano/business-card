# Copia questo file in backend/.env e compila la chiave.
# (Il file si chiama env.example e non .env.example perche' .gitignore
#  esclude qualunque *.env.*, altrimenti non finirebbe nel repo.)

# Chiave Anthropic — sostituisce la vecchia EMERGENT_LLM_KEY.
# Si ottiene da https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modello usato per l'estrazione. Opzionale: se non lo imposti si usa
# claude-sonnet-5.
# Alternativa piu' economica per la sola lettura di biglietti:
#   ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MODEL=claude-sonnet-5
